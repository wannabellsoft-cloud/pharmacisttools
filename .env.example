# --- Core -------------------------------------------------------------------
NODE_ENV=production
PORT=3000
PUBLIC_BASE_URL=https://pharmatools.example.org
TRUST_PROXY=1
DATA_DIR=./data
# 32+ random bytes, base64. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Losing this key makes all encrypted patient data unreadable. Store it in a secrets manager.
MASTER_KEY=

FACILITY_NAME_TH=โรงพยาบาลตัวอย่าง
FACILITY_NAME_EN=Example Hospital
FACILITY_PHONE=02-000-0000

# --- Security / workflow -----------------------------------------------------
SESSION_TTL_HOURS=8
CLAIM_TTL_MINUTES=10
CLAIM_MAX_ATTEMPTS=5
CLAIM_SESSION_TTL_MINUTES=15
# Require a different pharmacist to verify than the one who last edited (four-eyes).
REQUIRE_INDEPENDENT_REVIEWER=false

# --- PDPA retention (days) ---------------------------------------------------
RECORD_RETENTION_DAYS=1825
CLAIM_PURGE_DAYS=7
AUDIT_RETENTION_DAYS=3650
HOLDER_INACTIVE_DAYS=730
CONSENT_VERSION=2026-10

# --- Apple Wallet (all required to enable) -----------------------------------
APPLE_PASS_TYPE_ID=pass.org.example.allergycard
APPLE_TEAM_ID=
APPLE_PASS_CERT_PEM=./secrets/pass-cert.pem
APPLE_PASS_KEY_PEM=./secrets/pass-key.pem
APPLE_PASS_KEY_PASSPHRASE=
APPLE_WWDR_CERT_PEM=./secrets/AppleWWDRCAG4.pem
APPLE_APNS_ENABLED=true

# --- Google Wallet -----------------------------------------------------------
GOOGLE_WALLET_ISSUER_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=./secrets/google-wallet-sa.json
GOOGLE_WALLET_CLASS_SUFFIX=drug_allergy_card
GOOGLE_WALLET_ORIGINS=https://pharmatools.example.org
GOOGLE_WALLET_LOGO_URL=https://pharmatools.example.org/icons/icon-512.png
# Set to true ONLY after Google has approved this issuer for health/private passes.
GOOGLE_WALLET_HEALTH_PASS_APPROVED=false
GOOGLE_WALLET_PASS_TYPE=generic
