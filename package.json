{
  "name": "pharmatools",
  "version": "1.0.0",
  "description": "PharmaTools — a progressive web app of clinical tools for pharmacists, including drug allergy card issuance (physical and digital/Wallet).",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning server/index.js",
    "dev": "DEMO_SEED=1 node --disable-warning=ExperimentalWarning --watch server/index.js",
    "test": "node --disable-warning=ExperimentalWarning --test test/*.test.js",
    "create-pharmacist": "node --disable-warning=ExperimentalWarning scripts/create-pharmacist.js",
    "icons": "node scripts/generate-icons.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wannabellsoft-cloud/pharmacisttools.git"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "express": "^4.22.3",
    "node-forge": "^1.4.0",
    "pdfkit": "^0.20.2",
    "qrcode": "^1.5.4"
  }
}
